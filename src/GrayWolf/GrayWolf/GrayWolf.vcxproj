  <!-- Build OpenAssetTools' static libs from the vendored submodule before we
       compile/link, so the in-process OAT integration needs NO prebuilt binaries
       committed to git. Idempotent: tools\build-oat.ps1 no-ops once the libs
       exist, so this only pays the one-time build cost on a fresh checkout. -->
  <Target Name="BuildOat" BeforeTargets="PrepareForBuild"
          Condition="!Exists('$(MSBuildProjectDirectory)\..\..\External\OpenAssetTools\build\lib\Release_x64\ObjWriting.lib')">
    <Message Importance="high" Text="OpenAssetTools libs not found - building them from the submodule (one-time, several minutes)..." />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\..\tools\build-oat.ps1&quot;" />
  </Target>
  <!-- Ship the zonekit profiles (reader tables per game) next to the exe: zone-walk finds
       them at <exe dir>\zonekit\profiles\<game>, the material adapters its shading.txt, the gdt kind
       its gdt\<type>\ folders (Gdt.h), Cold War its strings.cipher.txt (Games\T9\StringCipher.h), the anim
       preview its reference rigs, preview_rigs.json (AssetGrid\AnimRigs.h). -->
  <Target Name="CopyZonekitProfiles" AfterTargets="Build">
    <ItemGroup>
      <ZonekitProfile Include="$(MSBuildProjectDirectory)\..\..\..\zonekit\profiles\**\profile.json;$(MSBuildProjectDirectory)\..\..\..\zonekit\profiles\**\types.json;$(MSBuildProjectDirectory)\..\..\..\zonekit\profiles\**\tables.*.txt;$(MSBuildProjectDirectory)\..\..\..\zonekit\profiles\**\blocks.txt;$(MSBuildProjectDirectory)\..\..\..\zonekit\profiles\**\empties.txt;$(MSBuildProjectDirectory)\..\..\..\zonekit\profiles\**\shading.txt;$(MSBuildProjectDirectory)\..\..\..\zonekit\profiles\**\strings.cipher.txt;$(MSBuildProjectDirectory)\..\..\..\zonekit\profiles\**\gdt\**\*.json;$(MSBuildProjectDirectory)\..\..\..\zonekit\profiles\**\gdt\**\*.jsonc;$(MSBuildProjectDirectory)\..\..\..\zonekit\profiles\preview_rigs.json" />
    </ItemGroup>
    <Copy SourceFiles="@(ZonekitProfile)" DestinationFiles="@(ZonekitProfile->'$(OutDir)zonekit\profiles\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>