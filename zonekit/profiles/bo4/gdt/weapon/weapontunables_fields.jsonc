    // The offset is proven (2026-10-22): the dump's raise-starting function (7ff7916c14c8) reads 0xda0
    // for every raise that is not the first (the firstRaiseTime getter, 0xd20), a quick one (0xfb0),
    // an empty one (0xd04) or the special case (0x1004); Black Ops III's raiseTime lands here first.
    {"offset": "0xda0", "name": "raiseTime", "source": "observed", "kind": "int", "form": "int", "observed": 0, "examples": []},

