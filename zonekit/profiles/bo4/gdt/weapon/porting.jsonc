{
  // Every field Black Ops 4 carries that has a counterpart in the earlier title's tools, and the entry
  // it fills. This is the whole of the mapping: nothing is inferred from spelling, so a field
  // that is not named here is not written, and a pairing here is one somebody decided on.
  //
  // Read down the left to audit what this title gives us. Where two fields fill one entry the
  // first of them the weapon actually carries is the one used, so the order here is the order
  // of preference.
  //
  // Adding a title is adding a folder with one of these in it. No code names a game.
  // Black Ops 4 gives the weapon no view or world model field of its own: it holds one model per
  // attachment slot and puts the weapon's own in the first. Reading one of those arrays takes the
  // first slot; the slots after it are cosmetic variants the earlier title has nowhere to put.
  // How this title counts a length of time. Where it says milliseconds, a whole number is taken as
  // a count of them and a number with a point in it is taken as already being seconds - the shape
  // of the number says which, because the engine writes a count whole and a fraction with a point.
  // Size is no guide and was tried: a fire time of sixteen milliseconds is a real rate of fire.
  //
  // A title that counts in seconds says so and nothing is converted. This is the rule most likely
  // to be wrong for an engine outside this lineage, and the one that fails quietly - a wrong guess
  // writes a plausible number rather than nothing at all.
  "times": "milliseconds",

  // Fields holding one entry per attachment slot rather than a single value, and which slot holds
  // the weapon's own. The slots after it are cosmetic variants of the same weapon, which the
  // earlier title has nowhere to put. Only the fields named here are read this way.
  "slots": {
    "attachViewModel": 0,
    "attachWorldModel": 0,
    "clipmodel": 0
  },

  // What each animation slot is for, in this title's own terms. The slot is what gives an
  // animation its meaning - the game reaches one by index, not by name - so this is the whole of
  // what makes an animation portable.
  //
  // These names are this title's, not the earlier one's. Where each belongs is said once for all
  // titles in data/bo3/anim_entries.jsonc, so improving that helps every title at once and a slot
  // with no entry yet is still written down here rather than lost.
  //
  // **The numbers are this title's own and do not carry over.** Every slot both this title and the
  // other one place sits at a different number in each: jump is 37 in Black Ops 4 and 43 in Cold
  // War, sprint_in 225 and 275. The slots mean the same things in the same order; a title inserts
  // animations and everything after moves down. So these are read per title, never copied.
  //
  // Read off the export: for each slot, what the weapons carrying it agree the animation is
  // called. Kept where that agreement is at least 85%% across ten weapons or more.
  //
  // szXAnims is the view model set, which is what the earlier title's entries are. playerAnims is
  // the third person set and has nothing to fill yet.
  "animations": {
    // Read off the animations themselves: a weapon names its asset after what the slot is for,
    // so a slot's purpose is the ending the weapons carrying it agree on. Where two slots look
    // alike, whether one weapon carries both separates them - 135 and 152 are the firing pair
    // (782 weapons carry both, 77% the same asset and the rest _fire_last), 254 and 259 the same
    // down the sights, 191 and 192 the reload pair.
    //
    // 297 and 299 said pullout and putaway and are swimming: 457 weapons name them
    // swim_uw_pullout. They filled nothing only because 220 sits below them and wins. 203 and 208
    // are the plain ones, carried by 887 and 885 against 220's 753.
    "szXAnims": {
      "37":    "jump",
      "39":    "jump_land",
      "43":    "fall",
      "47":    "walk_f",
      "48":    "mp9_walk_f_ads",
      "69":    "pose_l",
      "71":    "pose_r",
      "128":   "idle",
      "132":   "idle",
      "133":   "idle_ads",
      "134":   "fire_intro",
      "135":   "fire",
      "141":   "throw_quick",
      "150":   "cancel",
      "152":   "fire_last",
      "153":   "rechamber",
      "154":   "gunbutt_swipe",
      "159":   "swipe",
      "165":   "loop",
      "166":   "out",
      "172":   "swipe",
      "174":   "swipe",
      "175":   "swipe",
      "176":   "swipe",
      "178":   "out",
      "190":   "miss",
      "191":   "reload",
      "192":   "reload_empty",
      "195":   "reload_in",
      "196":   "reload_out",
      "197":   "reload_quick",
      "198":   "reload_quick_empty",
      "203":   "pullout",
      "207":   "first_raise",
      "208":   "putaway",
      "216":   "pullout_quick",
      "217":   "putaway_quick",
      "218":   "sprint_pullout",
      "219":   "sprint_putaway",
      "220":   "pullout",
      "221":   "putaway",
      "222":   "barehands_unstoppable_force_in",
      "223":   "barehands_unstoppable_force_loop",
      "224":   "barehands_unstoppable_force_out",
      "225":   "sprint_in",
      "226":   "sprint_loop",
      "228":   "sprint_out",
      "241":   "crawl_in",
      "242":   "crawl_f",
      "243":   "crawl_b",
      "244":   "crawl_r",
      "245":   "crawl_l",
      "246":   "crawl_out",
      "253":   "idle",
      "254":   "fire_ads",
      "258":   "ads",
      "259":   "fire_ads_last",
      "260":   "fire_ads_intro",
      "261":   "draw_ads",
      "262":   "draw_loop_ads",
      "263":   "draw_cancel_ads",
      "264":   "rechamber_ads",
      "271":   "inspect",
      "275":   "swim_to_land",
      "276":   "idle",
      "286":   "swim_uw_in",
      "287":   "swim_uw_f",
      "291":   "swim_uw_out",
      "292":   "swim_uw_putaway",
      "293":   "swim_uw_sprint_loop",
      "294":   "swim_tw_sprint_loop",
      "295":   "swim_uw_pullout",
      "296":   "swim_to_land",
      "297":   "swim_uw_pullout",
      "298":   "swim_uw_pullout",
