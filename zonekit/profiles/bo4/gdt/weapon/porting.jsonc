    // A reload that loads a round at a time is five entries working together, and with any of
    // them missing the target plays it wrong: the flag says the reload loops, the two counts say
    // how many rounds each pass and the opening add, and the two times are the opening and
    // closing animations' lengths.
    "segmentedReload":             "segmentedReload",
    "reloadStartAdd":              "reloadStartAdd",
    "reloadEndTime":               "reloadEndTime",

