{
  // Layout of Black Ops Cold War's weapon style settings asset, which a weapon reaches at +0xa48.
  //
  // This is where the title keeps what a shot does. The neighbouring title holds its damage curve
  // in the tunables; this one moved it out here, which is why searching the weapon and tunables
  // structs for it never found it, and why upgraded weapons appeared to raise no value at all -
  // the value they raise is not in the struct that was being read.
  //
  // A curve is two arrays of six: what the shot does at each stop, closest first, and the range
  // each stop reaches out to, ascending. A weapon that uses fewer stops leaves the rest zero in
  // both, and the same stops are the empty ones in each. Across the pool the ranges ascend on
  // every asset that carries a curve, and the damage falls on 519 of 551.
  //
  // 'engine' means the name is declared in a debug build of the neighbouring title, which shares
  // this struct's lineage. 'observed' means the engine declares nothing for it and the name here
  // describes what the field was seen to hold.
  //
  // 'observed' is how many of the loaded assets set the field, recomputed from the export so a
  // layout can be checked against the game rather than trusted.
  "struct": "WeaponStyleSettings",
  "pool": 37,
  "size": 464,
  "fields": [
    // What a shot does at each stop of its falloff, closest first. Whole numbers, and the field a
    // port has to carry: it is the entire time to kill.
    {"offset": "0x40", "name": "damage", "source": "engine", "kind": "int", "form": "int[]", "count": 6, "observed": 551, "examples": []},

    // The range each stop of the damage above reaches out to, ascending.
    {"offset": "0x58", "name": "damageRange", "source": "engine", "kind": "float", "form": "float[]", "count": 6, "observed": 630, "examples": []},

    // What one pellet of a multishot weapon does, on the weapons that fire more than one. Every
    // weapon that carries it is a shotgun or the shotgun pistol, and no other weapon carries it.
    {"offset": "0x78", "name": "multishotBaseDamage", "source": "engine", "kind": "int", "form": "int[]", "count": 6, "observed": 20, "examples": []},

    // The ranges the pellet damage above falls off over, which are its own rather than the ones
    // the bullet damage uses.
    {"offset": "0x90", "name": "multishotBaseDamageRange", "source": "engine", "kind": "float", "form": "float[]", "count": 6, "observed": 630, "examples": []},

    // How much a shot is scaled by where it lands, which is the difference between a headshot
    // mattering and not. The struct only points at these; the nineteen values live wherever the
    // pointer leads. Entry 0 is the default and the rest run head downwards, in the pairs a body
    // comes in - one weapon reads 1, 4, 4, 5, 1, 1, 0.9 then 0.8 0.8, 0.6 0.6, 0.4 0.4 twice over,
    // which is arms and then legs, each upper, lower and extremity.
    //
    // A pointer whose allocation was never brought in still reads as an address, and the words
    // behind it still read as floats, so the run is written only where every entry is a
    // multiplier rather than a leftover. Two assets of the pool fail that and are left empty.
    //
    // 21 of them: the game's hit location function (0x7ff638fe75c0 in BlackOpsColdWar_dump.exe)
    // indexes the table by hit location, and the exe's names (rdata 0x7ff63db373d0) are 21 - none,
    // helmet, head, neck, torso_upper, torso_mid, torso_lower, right/left_arm_upper,
    // right/left_arm_lower, right/left_hand, right/left_leg_upper, right/left_leg_lower,
    // right/left_foot, gun, riotshield (Rifling games/coldwar.md).
    {"offset": "0xb0", "name": "locationDamageMultipliers", "source": "engine", "kind": "float", "form": "float[]@", "count": 21, "maximum": 100, "observed": 631, "agreed": 629, "examples": []},




    // Read out of the game's own accessor for each of these, disassembled from the decrypted
    // exe. The accessor for meleedamage ends in
    // `mov rcx, [rax+0xa48]; mov eax, [rcx+0xb8]` - 0xa48 is the weapon's pointer to this struct,
    // so 0xb8 is where the value lives. The same two lines name 0xd0 for startammo and 0xd4 for
    // maxammo.
    //
    // These three were briefly removed for reading wrong against the game's field dump. They were
    // not wrong. That dump is taken with a weapon in hand, so it reports what the accessor returns
    // once attachments have been added and the count turned into rounds, while the struct holds
    // what the weapon was authored with. `ar_fastfire_t9` is the plain case - the dump says its
    // magazine holds 40 where the asset says 25, because the weapon carried an extended one.
    {"offset": "0xb8", "name": "meleedamage", "source": "engine", "kind": "int", "form": "int", "observed": 0, "examples": []},

    // A count of magazines rather than of rounds, which is how Black Ops 3 writes these two as
    // well - its own Kuda carries "clipSize" "30" beside "maxAmmo" "8", and across the 480 weapons
    // exported from it maxAmmo is 8, 5, 6 or 4 while clipSize is 20, 30 or 40. So the count is
    // carried straight across and multiplying it by the magazine size would be wrong: the earlier
    // title is asking the same question in the same units.
    //
    // The accessors do multiply, because what script asks them for is the number of rounds the
    // weapon can hold. That is not what the table wants.
    {"offset": "0xd0", "name": "startammo", "source": "engine", "kind": "int", "form": "int", "observed": 0, "examples": []},

    {"offset": "0xd4", "name": "maxammo", "source": "engine", "kind": "int", "form": "int", "observed": 0, "examples": []},

    // `cmp byte ptr [r8+0x18c], 0` in both accessors: set, and the count above is turned into
    // rounds before script sees it; clear, and it is passed on as it stands. Every gun sets it,
    // and the 521 that do not are abilities, gadgets and melee. Nothing reads it here - it is
    // named because the accessors do, and because it explains what they return.
    {"offset": "0x18c", "name": "ammoCountedInClips", "source": "engine", "kind": "int", "form": "byte", "observed": 0, "examples": []},

    {"offset": "0xe8", "name": "maxgibdistance", "source": "observed", "kind": "float", "form": "float", "observed": 0, "examples": []},

    // Carried from Black Ops 4, which names this field in its tunables, by matching values
    // across the 146 weapons the two games share. Cold War moved this tuning out of the
    // tunables and into the per-style struct. The control for this pass put 7 of 8 fields
    // the style struct already names onto the same offset.
    {"offset": "0x12c", "name": "aimAssistRange", "source": "observed", "kind": "float", "form": "float", "observed": 0, "examples": []},

    // Carried from Black Ops 4, which names this field in its tunables, by matching values
    // across the 146 weapons the two games share. Cold War moved this tuning out of the
    // tunables and into the per-style struct. The control for this pass put 7 of 8 fields
    // the style struct already names onto the same offset.
    {"offset": "0x130", "name": "aimAssistRangeAds", "source": "observed", "kind": "float", "form": "float", "observed": 0, "examples": []},

    // How far away an enemy has to be for the crosshair to mark them, and the same again while
    // aiming down the sight. The neighbouring title carries both, adjacent and in this order,
    // and the values come across unchanged on every weapon the two titles share.
    {"offset": "0x140", "name": "enemycrosshairrange", "source": "engine", "kind": "float", "form": "float", "observed": 602, "examples": []},

    {"offset": "0x144", "name": "enemycrosshairadsrange", "source": "engine", "kind": "float", "form": "float", "observed": 630, "examples": []},

    // Carried from Black Ops 4, which names this field in its tunables, by matching values
    // across the 146 weapons the two games share. Cold War moved this tuning out of the
    // tunables and into the per-style struct. The control for this pass put 7 of 8 fields
    // the style struct already names onto the same offset.
    {"offset": "0x14c", "name": "playerDamage", "source": "observed", "kind": "int", "form": "int", "observed": 0, "examples": []},

    // A third curve of the same shape, and the same on every weapon in the pool - 30 at the near
    // stop and 30 at the far one, whether the weapon is a knife or a sniper rifle. It is a default
    // rather than anything this weapon holds, so it is named for that and not for damage: carrying
    // it across as a weapon's damage would give every weapon the same one.
    {"offset": "0x154", "name": "defaultDamage", "source": "observed", "kind": "int", "form": "int[]", "count": 6, "observed": 630, "examples": []},

    // The ranges belonging to the default curve above, and as unvarying as it is.
    {"offset": "0x16c", "name": "defaultDamageRange", "source": "observed", "kind": "float", "form": "float[]", "count": 6, "observed": 630, "examples": []},

    // Both located by asking the engine: a GSC script read these by name across 233 weapons and
    // this is the offset carrying the matching value. shotcount agrees on all 233.
    //
    // clipsize agrees on 214 of 233 against the primary style, and on 231 once any of the four
    // style references a weapon carries is allowed - so the field is right and which style is
    // authoritative is the open part. The nineteen that differ are not noise: script reports 99
    // for equipment, which is its "unlimited" sentinel rather than a magazine, and a handful read
    // exactly double. Script gives the value as modified in play; this holds the base, and the
    // base is what a definition should carry.
    {"offset": "0xc8", "name": "clipsize", "source": "engine", "kind": "int", "form": "int", "observed": 548, "agreed": 214, "examples": []},
    {"offset": "0xe0", "name": "shotcount", "source": "engine", "kind": "int", "form": "int", "observed": 630, "agreed": 233, "examples": []},

    // ---- computed fields, found by matching values ----
    // The engine's field table names these but gives them no offset: a getter serves them, so
    // there is nothing in the table to read. Each was found the other way round - the game was
    // asked for it by name across 233 weapons, and this is the offset carrying the matching value
    // for every one of them.
    //
    // meleetime and meleechargetime are state timers, the length the animation is played over.
    // The note in this project said the engine does not report such things; asking for all 36 of
    // them by name got 5 back, so it reports some and not others. drop, raise and the ads
    // transitions really are absent - that part was right.

    {"offset": "0x10", "name": "explosioninnerradius", "source": "engine", "kind": "int", "form": "int", "observed": 13, "agreed": 233, "examples": []},
    {"offset": "0x18", "name": "explosioninnerdamage", "source": "engine", "kind": "int", "form": "int", "observed": 146, "agreed": 224, "examples": []},
    {"offset": "0x1c", "name": "explosionradius", "source": "engine", "kind": "int", "form": "int", "observed": 146, "agreed": 229, "examples": []},
    {"offset": "0x24", "name": "explosionouterdamage", "source": "engine", "kind": "int", "form": "int", "observed": 142, "agreed": 224, "examples": []},

    // Read out of the game's own accessor, which reaches this struct through `[weapon + 0xa48]`.
    // The field dump does not report either of these, so the offset is the accessor's word alone
    // and no value check was possible.
    {"offset": "0xd8", "name": "ammocountequipment", "source": "engine", "kind": "int", "form": "int", "observed": 0, "examples": []},
    {"offset": "0x10c", "name": "playermeleerange", "source": "engine", "kind": "float", "form": "float", "observed": 0, "examples": []}
  ]
}