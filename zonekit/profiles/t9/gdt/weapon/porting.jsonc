{
  // Every field Black Ops Cold War carries that has a counterpart in the earlier title's tools, and the entry
  // it fills. This is the whole of the mapping: nothing is inferred from spelling, so a field
  // that is not named here is not written, and a pairing here is one somebody decided on.
  //
  // Read down the left to audit what this title gives us. Where two fields fill one entry the
  // first of them the weapon actually carries is the one used, so the order here is the order
  // of preference.
  //
  // Adding a title is adding a folder with one of these in it. No code names a game.
  // Cold War names its models outright rather than holding them in attachment slots, so these are
  // ordinary fields - only the spelling of the view model differs.
  // How this title counts a length of time. See the same file under bo4 for what this means.
  "times": "milliseconds",

  // Cold War names its models outright rather than holding one per attachment slot, so it reads
  // no field as a slotted array. The section stays, empty, to say that is a fact about the title
  // rather than something nobody got round to.
  "slots": {},

  // What each animation slot is for, in this title's own terms. The slot is what gives an
  // animation its meaning - the game reaches one by index, not by name - so this is the whole of
  // what makes an animation portable.
  //
  // These names are this title's, not the earlier one's. Where each belongs is said once for all
  // titles in data/bo3/anim_entries.jsonc, so improving that helps every title at once and a slot
  // with no entry yet is still written down here rather than lost.
  //
  // **The numbers are this title's own and do not carry over.** Every slot both this title and the
  // other one place sits at a different number in each: jump is 37 in Black Ops 4 and 43 in Cold
  // War, sprint_in 225 and 275. The slots mean the same things in the same order; a title inserts
  // animations and everything after moves down. So these are read per title, never copied.
  //
  // Read off the export: for each slot, what the weapons carrying it agree the animation is
  // called. Kept where that agreement is at least 85%% across ten weapons or more.
  //
  // A name here says what the slot is for, which is not always a word about a gun. The freefall
  // and parachute slots are carried by 226 weapons apiece: every weapon has them, and they hold
  // the animations the player drops in with. The earlier title has no entry for any of it, so
  // they describe a slot without filling anything - which is what this file is for.
  //
  // Where several slots hold the same kind of animation, only the plain one carries the bare
  // name: 271 is the putaway and 270 the pullout, while the melee, super sprint and swimming
  // ones say so. Cold War does not order these the way Black Ops 4 does - its variants come
  // first - so taking the lowest slot without looking put a sprint putaway into dropAnim.
  //
  // szXAnims is the view model set, which is what the earlier title's entries are. playerAnims is
  // the third person set and has nothing to fill yet.
  "animations": {
    "szXAnims": {
      "17":   "additive_ads_up",
      "43":   "jump",
      "45":   "jump_land",
      "49":   "fall",
      "53":   "jog",
      "55":   "walk",
      "56":   "walk_f_ads",
      "60":   "walk_to_jog",
      "61":   "jog_to_walk",
      "63":   "hand_pose_l",
      "65":   "hand_pose_r",
      "113":  "settle",
      "125":  "idle_l",
      "138":  "br_freefall_anxiety_loop",
      "140":  "br_freefall_speed_up",
      "141":  "br_freefall_speed_flat",
      "142":  "br_freefall_speed_down",
      "144":  "br_freefall_strafe_up",
      "145":  "br_freefall_strafe_flat",
      "146":  "br_freefall_strafe_down",
      "148":  "br_freefall_yaw_up",
      "149":  "br_freefall_yaw_flat",
      "150":  "br_freefall_yaw_down",
      "152":  "br_freefall_pitch_up",
      "153":  "br_freefall_pitch_flat",
      "154":  "br_freefall_pitch_down",
      "155":  "br_freefall_shake",
      "156":  "br_freefall_shake",
      "157":  "br_freefall_shake",
      "163":  "br_parachute_shake",
      "164":  "br_parachute_pitch_flat",
      "165":  "br_parachute_strafe_flat",
      "166":  "br_parachute_yaw_flat",
      "167":  "br_parachute_pitch_flat",
      "168":  "br_parachute_lookpose",
      "169":  "idle",
      "170":  "ww_idle",
      "173":  "active_idle_a",
      "174":  "active_idle_b",
      "175":  "active_idle_c",
      "176":  "active_idle_d",
      "177":  "idle_empty",
      "178":  "idle_ads",
      "179":  "fire_intro",
      // Read off the animations themselves rather than guessed: every weapon that carries a slot
      // names its asset after what the slot is for, so a slot's purpose is the ending its names
      // share across weapons. 180 and 197 are the firing pair, 300 and 305 the same down the
      // sights; 236 and 238 are the reload pair. 248 and 249 held reload before and were the
      // wrong slots - a generic asset (vm_ar_standard_reload) that only ten weapons carry, all of
      // which also carry 236 with their own (vm_ar_standard_t9_reload). 236 reaches 213.
      "180":  "fire",
      "197":  "fire_last",
      "198":  "rechamber",
      "199":  "gunbutt_swipe",
      "236":  "reload",
      "237":  "reload_ads",
      "238":  "reload_empty",
      "239":  "reload_empty_ads",
      // The opening and closing of a reload that loads a round at a time, whose loop sits in 236.
      // 13 weapons name these reload_in / reload_out and the revolver reload_start / reload_end.
      "240":  "reload_in",
      "242":  "reload_out",
      "244":  "reload_quick",
      "245":  "ads",
      "246":  "reload_quick_empty",
      "256":  "first_raise",
