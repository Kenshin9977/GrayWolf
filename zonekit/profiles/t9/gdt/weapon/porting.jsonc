    "adsViewKickYawMin":             "adsViewKickYawMin",
    "adsZoom3_fStop":                "adsZoom3_fStop",
    "aimAssistRange":                "aimAssistRange",
    "aimAssistRangeAds":             "aimAssistRangeAds",
    "altDropTime":                   "altDropTime",
    "altRaiseTime":                  "altRaiseTime",
    "burstFireDelay":                "burstFireDelay",
    "cooldownRate":                  "cooldownRate",
    "crawlBackTime":                 "crawlBackTime",
    "crawlForwardTime":              "crawlForwardTime",
    "crawlInTime":                   "crawlInTime",
    "crawlLeftTime":                 "crawlLeftTime",
    "crawlOutTime":                  "crawlOutTime",
    "crawlRightTime":                "crawlRightTime",
    "doubleJumpCancelTime":          "doubleJumpCancelTime",
    "emptyDropTime":                 "emptyDropTime",
    "emptyRaiseTime":                "emptyRaiseTime",
    "fireDelay":                     "fireDelay",
    "hipGunKickPitchMin":            "hipGunKickPitchMin",
    "hipGunKickYawMax":              "hipGunKickYawMax",
    "hipIdleAmount":                 "hipIdleAmount",
    "hipIdleSpeed":                  "hipIdleSpeed",
    "hipSpreadDuckedDecay":          "hipSpreadDuckedDecay",
    "hipSpreadProneDecay":           "hipSpreadProneDecay",
    "hipSpreadStandMin":             "hipSpreadStandMin",
    "hipViewKickCenterSpeed":        "hipViewKickCenterSpeed",
    "hipViewKickMinMagnitude":       "hipViewKickMinMagnitude",
    "hipViewKickPitchMax":           "hipViewKickPitchMax",
    "hipViewKickYawMax":             "hipViewKickYawMax",
    "hipViewKickYawMin":             "hipViewKickYawMin",
    "holdFireTime":                  "holdFireTime",
    "introFireTime":                 "introFireTime",
    "jamFireTime":                   "jamFireTime",
    "kickAlignedInputScalar":        "kickAlignedInputScalar",
    "kickOpposedInputScalar":        "kickOpposedInputScalar",
    "meleedamage":                "meleeDamage",
    "deathcamtime":               "deathCamTime",
    "meleepowertime":             "meleePowerTime",
    "meleepowertimeLeft":         "meleePowerTimeLeft",
    "maxammo":                    "maxAmmo",
    "startammo":                  "startAmmo",

    // The two counts above are magazines only when this is set, in both titles: the flag is 1 on
    // every gun whose counts are small beside its magazine (ww_ray_rifle_t9: 30 rounds, 9 held)
    // and 0 where they are rounds, defaultweapon's 10 / 100 / 100 among them - which is what
    // Black Ops 3's own defaultweapon writes with the box clear. Without it the target read 9 as
    // nine rounds.
    "ammoCountedInClips":         "ammoCountClipRelative",
    "maxgibdistance":                "maxGibDistance",
    "offhandclass":                  "offhandClass",
    "offhandslot":                   "offhandSlot",
    "overheatRate":                  "overheatRate",
    "playerDamage":                  "playerDamage",
    "posProneMoveRate":              "posProneMoveRate",
    "posProneRotRate":               "posProneRotRate",
    "power_recharge_rate":           "gadget_power_recharge_rate",
    "quickDropTime":                 "quickDropTime",
    "raiseTime":                     "raiseTime",
    "slamTime":                      "slamTime",
    "slideInTime":                   "slideInTime",
    "slideLoopTime":                 "slideLoopTime",
    "slideOutTime":                  "slideOutTime",
    "sprintCombatCooldownTime":      "sprintCombatCooldownTime",
    "sprintDurationScale":           "sprintDurationScale",
    "sprintScale":                   "sprintScale",
    "strafeRotR":                    "strafeRotR",
    "swimCombatCooldownTime":        "swimCombatCooldownTime",
    "swimCombatInTime":              "swimCombatInTime",
    "swimCombatOutTime":             "swimCombatOutTime",
    "swimFromLandTime":              "swimFromLandTime",
    "swimIdleLoopTime":              "swimIdleLoopTime",
    "swimMovingBackwardTime":        "swimMovingBackwardTime",
    "swimMovingForwardTime":         "swimMovingForwardTime",
    "swimMovingInTime":              "swimMovingInTime",
    "swimMovingLeftTime":            "swimMovingLeftTime",
    "swimMovingOutTime":             "swimMovingOutTime",
    "swimMovingRightTime":           "swimMovingRightTime",
    "swimSprintInTime":              "swimSprintInTime",
    "swimSprintLoopTime":            "swimSprintLoopTime",
    "swimSprintOutTime":             "swimSprintOutTime",
    "swimSprintSurfaceLoopTime":     "swimSprintSurfaceLoopTime",
    "swimToLandTime":                "swimToLandTime",
    "hipSpreadFireAdd":            "hipSpreadFireAdd",
    "lockOnLostSightPivotTimeout": "lockOnLostSightPivotTimeout",
    "meleeJukeDecelTime": "meleeJukeDecelTime",
    "adsTurnRateScalar": "adsTurnRateScalar"
  },

  // Entries the earlier title fills with an animation of the player's own hands rather than the
  // weapon's, so every weapon it ships carries the same one. Neither later title has a per-weapon
  // slot for them, so without this they would be written empty and the weapon would mantle and
  // swim wrongly.
  //
  // The values are what Black Ops 3 itself uses: across the weapons that set them, 332 name this
  // swim sprint loop, 341 this surface loop, and 334 each of the two mantle exits. The handful
  // that differ are dual wield and the melee weapons, which have hands of their own.
  //
  // Swept every animation entry in the schema for others like these: below the eight here the
  // commonest value covers 22% of the weapons that set it, so there is no ninth.
  "constants": {
    "swimSprintLoop":        "vm_bare_hands_swim_uw_sprint_loop",
    "swimSprintSurfaceLoop": "vm_bare_hands_swim_tw_sprint_loop",
    "trmOutAnim":            "vm_bare_hands_mantle_wall_out",
    "trmOutLowAnim":         "vm_bare_hands_mantle_wall_out_low",

    // The ability cast, which is the player's hands again and never the weapon's. Every weapon
    // that sets these names the same animation - 274 of 274 for the cast itself and 106 of 106 for
    // each of the three passive states - and neither later title has a slot for any of them.
    "castAbility":           "vm_barehands_passive_ability_use",
    "castPassiveIn":         "vm_barehands_passive_ability_in",
    "castPassiveLoop":       "vm_barehands_passive_ability_loop",
    "castPassiveOut":        "vm_barehands_passive_ability_out"
  },

  // Entries this title leaves at nothing but the earlier title always writes the same way beside a
  // value this title does carry. Cold War holds the side reticle's image and a size of zero on
  // all 685 weapons; Black Ops 3 draws reticle_side_small at 8 on all 364 weapons that use it and
  // the rotated one at 8 on all 5. reticle_side_round is left out: the earlier title writes it at
  // 32, 8 and 1 about equally, so there is no rule to follow and the entry keeps its default.
  //
  // The centre reticle is the same, and the list is every image Black Ops 3 sizes consistently -
  // at least three weapons, and one size on four in five of them - so it is identical in every
  // title's file. The crosses and the flechette are 32 on 39 of 41, 33 of 38 and 38 of 40, semtex
  // 20 on 17 of 21, the minigun 37 on 5 of 6, and the rest one size on every weapon using them.
  // An image not listed, the ballistic knife's among them (48 / 42), keeps the default of 32.
  "implied": {
    "reticleSideSize": {
      "from": "reticleSide",
      "values": {
        "reticle_side_small":         "8",
        "reticle_side_small_rotated": "8"
      }
    },
    "reticleCenterSize": {
      "from": "reticleCenter",
      "values": {
        "chemicalgelgun_reticle":                 "128",
        "emp_reticle":                            "32",
        "hud_rts_mech_reticle":                   "32",
        "mp_hud_dot":                             "32",
        "reticle_bouncingbetty_cross":            "32",
        "reticle_center_cross":                   "32",
        "reticle_center_cross_mg42":              "32",
        "reticle_crossbow":                       "80",
        "reticle_flechette":                      "32",
        "reticle_incendiary_cross":               "32",
        "reticle_m203":                           "128",
        "reticle_minigun":                        "37",
        "reticle_pineapplegun":                   "128",
        "reticle_semtex":                         "20",
        "shockcharge_reticle":                    "27",
        "smokescreen_reticle":                    "32",
        "t7_hud_cp_hud_reticles_armbladereticle": "63",
        "t7_hud_reticle_mp_hero_scythe":          "32",
        "tactical_gren_reticle":                  "32"
      }
    }
  },

  // A field holding a curve, spelled out across the entries the earlier title numbers. The
  // stops are written in order and a stop the weapon leaves unset is left out.
  "curves": {
    "attachViewOffsetOptic": [
      "attachViewModelOffsetX1",
      "attachViewModelOffsetY1",
      "attachViewModelOffsetZ1"
    ],
    "attachWorldOffsetOptic": [
      "attachWorldModelOffsetX1",
      "attachWorldModelOffsetY1",
      "attachWorldModelOffsetZ1"
    ],
    "attachViewRotationOptic": [
      "attachViewModelOffsetPitch1",
      "attachViewModelOffsetYaw1",
      "attachViewModelOffsetRoll1"
    ],
    "attachWorldRotationOptic": [
      "attachWorldModelOffsetPitch1",
      "attachWorldModelOffsetYaw1",
      "attachWorldModelOffsetRoll1"
    ],
    "attachViewOffsetOpticAds": [
      "attachViewModelOffsetX2",
      "attachViewModelOffsetY2",
