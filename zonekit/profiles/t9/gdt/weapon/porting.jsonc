    "xcam_500":                              ["cacWeaponXCam", "cacAttachmentsXCam"],
    "xcam_508":                              "weaponIconXCam",

    // Paired 2026-09-01, once the offsets behind them were found. A field with no pairing
    // is read out of the struct and then goes nowhere, which is why startAmmo came out
    // empty on Cold War.
    "adsAdditiveJumpScalar":         "adsAdditiveJumpScalar",
    "adsBobFactor":                  "adsBobFactor",
    "adsDofEnd":                     "adsDofEnd",
    "adsDofStart":                   "adsDofStart",
    "adsReloadTransTime":            "adsReloadTransTime",
    "adsSwayLerpSpeed":              "adsSwayLerpSpeed",
    // adsSwayMaxAngle, adsSwayYawScale and hipGunKickPitchMin were paired 2026-09-07 with the
    // offsets behind them, each read off what was already named around it: the two sway members
    // complete a family whose other four were known, the gun kick min a pair whose max was.
    "adsSwayMaxAngle":               "adsSwayMaxAngle",
    "adsSwayPitchScale":             "adsSwayPitchScale",
    "adsSwayYawScale":               "adsSwayYawScale",
    "adsViewKickCenterSpeed":        "adsViewKickCenterSpeed",
