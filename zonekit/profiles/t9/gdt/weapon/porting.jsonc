    // An empty reload runs longer than a full one - a quarter longer, on both Black Ops 3's
    // own weapons and on this title's animations - and with nothing filling the entry every
    // weapon took the tools' default of two seconds instead, shorter than most weapons' plain
    // reload. The animation then played squeezed into two seconds while a reload sound baked at
    // full length ran on past it, which is how this was noticed.
    "reloadEmptyAddTime":          "reloadEmptyAddTime",
    "reloadEmptyTime":             "reloadEmptyTime",

    // A reload that loads a round at a time is five entries working together, and with any of
    // them missing the target plays it wrong: the flag says the reload loops, the two counts say
    // how many rounds each pass and the opening add, and the two times are the opening and
    // closing animations' lengths. reloadAmmoAdd was placed long before and never paired, so it
    // was read and thrown away and every such weapon added nothing per pass.
    "segmentedReload":             "segmentedReload",
    "reloadAmmoAdd":               "reloadAmmoAdd",
    "reloadStartAdd":              "reloadStartAdd",
    "reloadStartAddTime":          "reloadStartAddTime",
    "reloadStartTime":             "reloadStartTime",
    "reloadEndTime":               "reloadEndTime",

