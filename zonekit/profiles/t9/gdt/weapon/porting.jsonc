      "attachViewModelOffsetRoll5"
    ],
    "attachWorldRotationMag": [
      "attachWorldModelOffsetPitch5",
      "attachWorldModelOffsetYaw5",
      "attachWorldModelOffsetRoll5"
    ],
    "damage": [
      "damage",
      "damage2",
      "damage3",
      "damage4",
      "damage5",
      "minDamage"
    ],
    "damageRange": [
