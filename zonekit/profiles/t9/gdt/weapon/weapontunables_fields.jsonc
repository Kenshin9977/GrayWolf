    // NOT A REAL NAME. The game does not call this field anything - this label was made up here to describe what the field was seen to hold. It is a guess at the meaning, not the game's own word, and it may be wrong. Names without this comment are the game's own.
    {"offset": "0xfe0", "name": "reloadEmptyTime", "source": "observed", "kind": "int", "form": "int", "observed": 0, "examples": []},

    // The rest of the reload family, which runs in the earlier title's alphabetical order from
    // reloadAddTime at 0xfd4 to reloadtime at 0x1028. Four anchors fix the run: 0xfec-0xff8 hold,
    // on a gun with a fast magazine, exactly its add, empty add, empty and plain reload times
    // again (the quick copies); 0xfd8 and 0x101c hold the same round count, 1 to 3, and only on
    // the 14 weapons that load a round at a time; and the times match the animations they play
    // over. reloadEndTime is the length of the weapon's reload_out animation (ratio 1.00 on the
    // pump and semi-auto shotguns, 1.02 on the revolver) and reloadStartTime the length of its
    // reload_in (1.00 on the same three), with reloadStartAddTime landing partway through it
    // as the earlier title's own shotguns do.
    {"offset": "0xfe8", "name": "reloadEndTime", "source": "observed", "kind": "int", "form": "int", "observed": 0, "examples": []},
    {"offset": "0x101c", "name": "reloadStartAdd", "source": "observed", "kind": "int", "form": "int", "observed": 0, "examples": []},
    {"offset": "0x1020", "name": "reloadStartAddTime", "source": "observed", "kind": "int", "form": "int", "observed": 0, "examples": []},
    {"offset": "0x1024", "name": "reloadStartTime", "source": "observed", "kind": "int", "form": "int", "observed": 0, "examples": []},

    // Set only on weapons that work the action between shots, and on all of them. The pair sits
    // between raiseTime and reloadAddTime where the alphabet puts it, bolt before the whole
    // rechamber and never longer than it. hero_annihilator is in both titles and reads 550 and
    // 550 here against the earlier title's 0.55 and 0.55; the vehicle turrets read 100, which is
    // that title's default of 0.1.
    {"offset": "0xfc8", "name": "rechamberBoltTime", "source": "observed", "kind": "int", "form": "int", "observed": 0, "examples": []},
    {"offset": "0xfcc", "name": "rechamberTime", "source": "observed", "kind": "int", "form": "int", "observed": 0, "examples": []},

    // 1 on every weapon carrying a rechamber animation - the bolt snipers, the pump and lever
    // shotguns, the bows - and on hero_annihilator, which rechambers in the earlier title too;
    // 0 on all 644 others. Between reticleCenterSize and slamTime, where the alphabet puts it.
    {"offset": "0x1038", "name": "shotsBeforeRechamber", "source": "observed", "kind": "int", "form": "int", "observed": 0, "examples": []},

    // 1 on the 14 weapons whose reload animation slot holds a reload_loop and 0 on the 193 whose
    // slot holds an ordinary reload. The three zombietron top-down variants carry the loop
    // animations with this off, which is that mode rather than a miss. Directly before
    // setusedstat at 0x1333, where the alphabet puts it.
    {"offset": "0x1332", "name": "segmentedReload", "source": "observed", "kind": "int", "form": "byte", "observed": 0, "examples": []},

