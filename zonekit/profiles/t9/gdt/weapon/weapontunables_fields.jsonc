{
  // Layout of Black Ops Cold War's weapon tunables asset.
  //
  // The numeric fields are named by the weapons that survive from an earlier title, where the
  // field names are known: a value carried over unchanged sits at some offset here, and an offset
  // holding the same field's value across many weapons is that field. Every weapon type that
  // title exports is a donor, since they all share the one struct.
  //
  // What is kept:
  //   - three or more adjacent offsets matching three or more fields adjacent in the earlier
  //     struct, in the same order, which is a whole group landing intact;
  //   - two adjacent offsets where at least 60 weapons agree on at least three distinct values and
  //     the name also appears in the field list a debug build of this lineage declares.
  //
  // Competing runs are settled by weight of evidence, longest and best attested first, and a run
  // that would take an offset already spoken for is dropped whole rather than fragmented. Claiming
  // in address order instead silently costs the stronger run its members: the sway group lost
  // three of its six that way, and two of the remaining three landed on worse offsets than the
  // data supports.
  //
  // 'observed' is how many of the loaded assets set the field. It is recomputed from the export
  // rather than written by hand, so a layout can be checked against the game instead of
  // trusted: a field that stops being set is a field that moved.
  //
  // 'agreed', where a field has one, is the older measure - how many of the shared weapons
  // agreed on that field when the name was placed. It is how well attested the name is, which
  // is a different question from how many assets carry a value, and worth keeping apart.
  //
  // 166 weapons are present in both titles.
  //
  // Offsets are only valid for the struct size recorded here.
  //
  // Audited afterwards, which is what settles whether a name sits on its own field or on a
  // neighbour that happens to carry similar numbers. For every offset the audit asks which
  // field fits it best, and for every field which offset fits it best. Being contradicted is
  // not itself wrong - a title re-tunes a weapon and the value legitimately differs - but
  // being contradicted more often than agreed while a distant offset carries the field better
  // is the mark of a misplaced name, and that is how a contiguous but poorly supported run
  // beats a scattered but well supported one.
  //
  // Fields failing that test were moved where the better offset was unclaimed and the two
  // chose each other, and dropped otherwise. A field flagged only because an adjacent sibling
  // fits marginally better is left alone: fields holding the same value as one another cannot
  // be separated by value at all, and their order within the run is what tells them apart.
  //
  // A second donor was run over this: the neighbouring title's own export, which is a generation
  // closer than the earlier one and whose fields are named and audited here rather than taken
  // from outside. It places 35 of these fields, agrees with 29 of them, and adds ten more.
  //
  // Where the two donors disagree the stronger evidence stands, which is usually the earlier
  // title's - it pairs 166 weapons against this one's 56. The exception is hipSpreadMax, where
  // the second donor and the audit independently prefer the same different offset, so it moved.

  "struct": "WeaponTunables",
  "pool": 39,
  "size": 5144,
  // What a shot does is not in this layout. The game reads a weapon's damage as an array whose
  // first entry is the closest range and whose last is the farthest, and reads a second array
  // beside it for the pellets of a multishot weapon. Neither is at any offset of this struct:
  // every run of falling numbers in it was read and none varies per weapon the way damage must,
  // the struct holds one pointer in its whole length and that points at recoil, and the value
  // that does vary by class - 30 for a rifle, 99 for a sniper, 1 for a knife - is the same for
  // every weapon of a class, which makes it a class constant rather than a weapon's damage.

  "fields": [
    // What a shot keeps of its speed when it hits a surface, along it and into it, one value per
    // surface. The neighbouring title holds the same pair in the same order and its debug build
    // names them; here they read value for value the same, on the same weapons - a claymore keeps
    // 0.5, 0.6, 0.6, 0.6 along and a flat 0.25 into, a frag grenade 0.7 against 0.2.
    //
    // The variety is all in what bounces: 241 of the 242 bullet weapons and every melee weapon
    // leave both at the default half, and the projectiles that stick read zero for both.
    {"offset": "0x0", "name": "parallelBounce", "source": "engine", "kind": "float", "form": "float[]@", "count": 40, "maximum": 100, "observed": 534, "examples": []},

    {"offset": "0x8", "name": "perpendicularBounce", "source": "engine", "kind": "float", "form": "float[]@", "count": 40, "maximum": 100, "observed": 534, "examples": []},

    {"offset": "0xb4", "name": "lowReadyOfsR", "source": "engine", "kind": "float", "form": "float", "observed": 174, "agreed": 61, "examples": []},

    {"offset": "0xb8", "name": "lowReadyOfsU", "source": "engine", "kind": "float", "form": "float", "observed": 175, "agreed": 58, "examples": []},

    {"offset": "0xbc", "name": "lowReadyRotP", "source": "engine", "kind": "float", "form": "float", "observed": 174, "agreed": 60, "examples": []},

    {"offset": "0xc0", "name": "lowReadyRotY", "source": "engine", "kind": "float", "form": "float", "observed": 174, "agreed": 58, "examples": []},

    {"offset": "0xc4", "name": "lowReadyRotR", "source": "engine", "kind": "float", "form": "float", "observed": 174, "agreed": 61, "examples": []},

    // Carried from the other title, which names this field, by matching values across the
    // weapons the two share. The control for this pass put 87 of 90 fields both games
    // already name onto the same offset.
    {"offset": "0x124", "name": "strafeRotR", "source": "observed", "kind": "float", "form": "float", "observed": 0, "examples": []},

    {"offset": "0x14c", "name": "duckedOfsF", "source": "engine", "kind": "float", "form": "float", "observed": 303, "agreed": 51, "examples": []},

    {"offset": "0x150", "name": "duckedOfsR", "source": "engine", "kind": "float", "form": "float", "observed": 264, "agreed": 89, "examples": []},

    {"offset": "0x154", "name": "duckedOfsU", "source": "engine", "kind": "float", "form": "float", "observed": 229, "agreed": 26, "examples": []},

    {"offset": "0x170", "name": "proneOfsF", "source": "engine", "kind": "float", "form": "float", "observed": 270, "agreed": 64, "examples": []},

    // The rest of the prone offset, the vector 0x170 begins, laid out like duckedOfs at 0x14c.
    // They used to sit at 0x420 and 0x934, columns holding 3.5 and 0.8 on nearly every weapon -
    // the earlier title's defaults for these two entries, which is all they ever matched. These
    // carry the earlier title's own odd vectors whole where the weapon is shared: claymore
    // (3, 0, -2.7), the remote missile bomblet (40, 0.5, -7), the riot shield (2, 2, -1.6).
    {"offset": "0x174", "name": "proneOfsR", "source": "observed", "kind": "float", "form": "float", "observed": 0, "examples": []},
    {"offset": "0x178", "name": "proneOfsU", "source": "observed", "kind": "float", "form": "float", "observed": 0, "examples": []},

    {"offset": "0x194", "name": "standMoveF", "source": "engine", "kind": "float", "form": "float", "observed": 233, "agreed": 40, "examples": []},

    {"offset": "0x198", "name": "standMoveR", "source": "engine", "kind": "float", "form": "float", "observed": 188, "agreed": 37, "examples": []},

    {"offset": "0x19c", "name": "standMoveU", "source": "engine", "kind": "float", "form": "float", "observed": 249, "agreed": 65, "examples": []},

    {"offset": "0x1a0", "name": "standRotP", "source": "engine", "kind": "float", "form": "float", "observed": 277, "agreed": 82, "examples": []},

    {"offset": "0x1ac", "name": "duckedMoveF", "source": "engine", "kind": "float", "form": "float", "observed": 206, "agreed": 66, "examples": []},

    {"offset": "0x1b0", "name": "duckedMoveR", "source": "engine", "kind": "float", "form": "float", "observed": 218, "agreed": 57, "examples": []},

    {"offset": "0x1b4", "name": "duckedMoveU", "source": "engine", "kind": "float", "form": "float", "observed": 238, "agreed": 66, "examples": []},

    {"offset": "0x1c4", "name": "proneMoveF", "source": "engine", "kind": "float", "form": "float", "observed": 57, "agreed": 16, "examples": []},

    {"offset": "0x1c8", "name": "proneMoveR", "source": "engine", "kind": "float", "form": "float", "observed": 259, "agreed": 63, "examples": []},

    {"offset": "0x1cc", "name": "proneMoveU", "source": "engine", "kind": "float", "form": "float", "observed": 273, "agreed": 69, "examples": []},

    {"offset": "0x1d4", "name": "proneRotY", "source": "engine", "kind": "float", "form": "float", "observed": 229, "agreed": 73, "examples": []},

    {"offset": "0x1d8", "name": "proneRotR", "source": "engine", "kind": "float", "form": "float", "observed": 229, "agreed": 73, "examples": []},

    // Named by the weapons this title shares with the neighbouring one, where the field is the
    // engine's own: the value carried over unchanged on every one of the 137 shared weapons,
    // and onto no other offset.
    {"offset": "0x2c0", "name": "gadget_max_hitpoints", "source": "engine", "kind": "int", "form": "int", "observed": 533, "examples": []},

