    {"offset": "0xf84", "name": "meleetime", "source": "engine", "kind": "int", "form": "int", "observed": 531, "agreed": 233, "examples": []},
    {"offset": "0xfa0", "name": "projectilespeed", "source": "engine", "kind": "int", "form": "int", "observed": 471, "agreed": 233, "examples": []},

    // NOT A REAL NAME. The game does not call this field anything - this label was made up here to describe what the field was seen to hold. It is a guess at the meaning, not the game's own word, and it may be wrong. Names without this comment are the game's own.
    {"offset": "0xfd4", "name": "reloadAddTime", "source": "observed", "kind": "int", "form": "int", "observed": 0, "examples": []},
