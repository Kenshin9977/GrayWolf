    {"offset": "0x48c", "name": "offhandclass", "source": "observed", "kind": "int", "form": "int", "observed": 0, "examples": []},

    // Carried from the other title, which names this field, by matching values across the
    // weapons the two share. The control for this pass put 87 of 90 fields both games
    // already name onto the same offset.
    {"offset": "0x490", "name": "offhandslot", "source": "observed", "kind": "int", "form": "int", "observed": 0, "examples": []},

    // Named constants rather than a quantity. Which number means what was read out of Black
    // Ops 4, where the game reports the name for each weapon and the struct stores the number.
    // The offset here is the column where every weapon whose name says what it is carries the
    // matching number - every ar_ is 0, every smg_ is 2, every melee_ is 11 - across 57
    // weapons with one exception. Snipers and tactical rifles carry the rifle number, which is
    // what they are.
    {"offset": "0x560", "name": "weapclass", "source": "engine", "kind": "int", "form": "int", "values": {"0": "rifle", "1": "mg", "2": "smg", "3": "spread", "4": "pistol", "5": "grenade", "6": "rocketlauncher", "9": "gas", "11": "melee"}, "observed": 457, "agreed": 57, "examples": []},

    // The only column where a weapon named burst fires in bursts, one named semi fires single
    // shots, the autos are full auto and the melee weapons are melee - four groups the name
    // settles, all landing on the numbers Black Ops 4 reports for them.
    {"offset": "0x568", "name": "firetype", "source": "engine", "kind": "int", "form": "int", "values": {"0": "Full Auto", "1": "Single Shot", "2": "Burst", "3": "Auto Burst", "6": "Minigun", "7": "Charge Shot", "11": "Melee"}, "observed": 188, "agreed": 46, "examples": []},

    // Sits where Black Ops 4 puts the same field relative to weapclass, and reads what it should:
    // guns and melee weapons are primary, and only the equipment is offhand or an ability.
    {"offset": "0x56c", "name": "inventorytype", "source": "engine", "kind": "int", "form": "int", "values": {"0": "primary", "1": "offhand", "4": "melee", "5": "dwlefthand", "6": "ability", "7": "heavy"}, "observed": 236, "agreed": 69, "examples": []},

    // The numbers mean what Black Ops 4 reports them to mean, read there from the game itself.
    // This column is the one where every family of weapon lands on the right one: every rifle,
    // pistol, shotgun and sniper reads bullet, every melee weapon melee, every launcher
    // projectile, and the grenades, mines and molotovs grenade. Eighteen columns separate
    // melee weapons from guns; this is the only one that separates them into those numbers.
    // Values seen here that Black Ops 4 never reported are left as numbers rather than named.
    {"offset": "0x5ac", "name": "type", "source": "engine", "kind": "int", "form": "int", "values": {"0": "bullet", "1": "grenade", "2": "projectile", "4": "gas", "7": "melee", "9": "script"}, "observed": 308, "agreed": 56, "examples": []},

