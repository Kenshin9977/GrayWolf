    {"offset": "0x344", "name": "gadget_power_round_end_active_penalty", "source": "engine", "kind": "int", "form": "int", "observed": 36, "examples": []},
    {"offset": "0x36c", "name": "gadget_pulse_speed", "source": "engine", "kind": "float", "form": "float", "observed": 533, "examples": []},

